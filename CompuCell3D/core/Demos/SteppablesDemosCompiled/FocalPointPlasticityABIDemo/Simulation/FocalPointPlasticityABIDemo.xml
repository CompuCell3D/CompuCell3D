<CompuCell3D>

    <Potts>
        <Dimensions x="60" y="30" z="1"/>
        <Steps>20</Steps>
        <Temperature>5</Temperature>
        <NeighborOrder>2</NeighborOrder>
    </Potts>

    <Plugin Name="CellType">
        <CellType TypeName="Medium" TypeId="0"/>
        <CellType TypeName="Cell1" TypeId="1"/>
        <CellType TypeName="Cell2" TypeId="2"/>
    </Plugin>

    <Plugin Name="Volume">
        <TargetVolume>120</TargetVolume>
        <LambdaVolume>2.0</LambdaVolume>
    </Plugin>

    <Plugin Name="Contact">
        <Energy Type1="Medium" Type2="Medium">0.0</Energy>
        <Energy Type1="Medium" Type2="Cell1">16.0</Energy>
        <Energy Type1="Medium" Type2="Cell2">16.0</Energy>
        <Energy Type1="Cell1" Type2="Cell1">8.0</Energy>
        <Energy Type1="Cell1" Type2="Cell2">20.0</Energy>
        <Energy Type1="Cell2" Type2="Cell2">8.0</Energy>
    </Plugin>

    <Plugin Name="CenterOfMass"/>

    <Plugin Name="FocalPointPlasticity">
        <!-- Local makes link energy use each link's stored parameters. -->
        <Local/>
        <Parameters Type1="Cell1" Type2="Cell2">
            <Lambda>10.0</Lambda>
            <ActivationEnergy>-50.0</ActivationEnergy>
            <TargetDistance>15.0</TargetDistance>
            <MaxDistance>40.0</MaxDistance>
            <MaxNumberOfJunctions>2</MaxNumberOfJunctions>
        </Parameters>
        <InternalParameters Type1="Cell1" Type2="Cell2">
            <Lambda>7.0</Lambda>
            <ActivationEnergy>-50.0</ActivationEnergy>
            <TargetDistance>12.0</TargetDistance>
            <MaxDistance>35.0</MaxDistance>
            <MaxNumberOfJunctions>2</MaxNumberOfJunctions>
        </InternalParameters>
    </Plugin>

</CompuCell3D>
